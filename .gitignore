# ==============================================================================
# AcousticHddSentinel - Comprehensive .gitignore
# Zgodny ze standardem projektu, ADR-001 oraz ADR-002
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python: Bytecode, Cache, Test & Linters
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/

# Test runner, coverage & linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Środowiska wirtualne Pythona
venv/
.venv/
.venv*/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 2. PyTorch & Machine Learning: Checkpoints i modele tymczasowe
# ------------------------------------------------------------------------------
checkpoints/
*.ckpt
checkpoint_*.pt
*checkpoint*.pt
epoch_*.pt
tmp_*.pt
temp_*.pt

# Kopie zapasowe modeli i pośrednie wersje treningowe
models_backup/
training_output/models/

# Monitoring & telemetry
runs/
wandb/
.neptune/

# Modele i wagi lokalne (nie śledzić na GitHubie - odtwarzalne treningiem/eksportem)
training_output/*.pt
training_output/*.png
training_output/stress_test_gpu/
exported_models/*.onnx
exported_models/*.pt
exported_models/AcousticClassifierAndroid.java

# ------------------------------------------------------------------------------
# 3. Android & Gradle: Pliki kompilacji, pamięć podręczna i pakiety
# ------------------------------------------------------------------------------
.gradle/
android/.gradle/
local.properties
android/local.properties

# Artefakty budowania
build/
android/build/
android/*/build/
.cxx/
android/.cxx/
android/*/.cxx/
.externalNativeBuild/
android/.externalNativeBuild/
android/*/.externalNativeBuild/

# Pakiety aplikacji mobilnej (tymczasowe APK i AAB)
*.apk
*.aab
android/*.apk
android/*.aab
android/app/*.apk
android/app/build/outputs/apk/

# Raporty i zrzuty Android SDK
captures/
android/app/lint-baseline.xml

# Zabezpieczenie zasobów Android (ONNX INT8, classes.json, model_card.json)
!android/app/src/main/assets/**

# ------------------------------------------------------------------------------
# 4. IDE, Edytory i narzędzia programistyczne
# ------------------------------------------------------------------------------
# JetBrains / Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/
*.code-workspace

# Edytory tekstu i pliki wymiany (Vim, Emacs, Nano)
*.swp
*.swo
*.tmp
*.temp
*.bak
*~
.#*
#*#

# Eclipse
.project
.classpath
.settings/

# ------------------------------------------------------------------------------
# 5. Systemy operacyjne (Linux, macOS, Windows)
# ------------------------------------------------------------------------------
# Linux
*~
.directory
.fuse_hidden*
.Trash-*
.nfs*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 6. Specyficzne dla AcousticHddSentinel: Zbiory generowane i testy
# ------------------------------------------------------------------------------
# Generowane zbiory tensorów (odtwarzalne skryptami z data/raw zgodnie z ADR-001)
dataset_categorized/
dataset_encoded/

# Artefakty testów obciążeniowych, próbek adversarial i tymczasowe wyjścia parity
stress_test_output/
tests/adversarial_lab/samples/
tests/tmp_parity/

# Lokalne surowce audio i nagrania studyjne (trzymane lokalnie na dysku, poza GitHubem)
data/raw/*
!data/raw/PROCESSED_SOURCES_REGISTRY.json
tests/recordings_4min_study/**/*.wav
tests/noise_experiment/*.wav

# Dokumentacja wewnętrzna agentów AI, raporty lokalne i narzędzia pomocnicze
AGENTS.md
.agents/
kontekst.md
docx/Projekt_AM.pdf
docx/STRATEGIC_ROADMAP.md
docx/RAPORT_STRESS_TEST_GPU_VRAM.md
docx/RAPORT_SYMULACJI_POTOKU_MIKROFONU.md
scripts/create_notebooklm_bundle.py

# ------------------------------------------------------------------------------
# 7. Archiwa historyczne i paczki ewaluacyjne
# ------------------------------------------------------------------------------
archive/
archive.zip
projekt_calosc.txt
kod_v4_smpc_pytorch.txt
kod_v5_android_dsp.txt

# Logi systemowe
*.log
