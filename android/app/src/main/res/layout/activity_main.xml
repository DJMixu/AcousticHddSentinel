<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <!-- Główna zawartość ekranu (CoordinatorLayout) -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!-- Górny pasek narzędziowy TopAppBar z przyciskiem szuflady nawigacyjnej -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/background"
                app:contentInsetStart="12dp"
                app:contentInsetEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Przycisk menu / hamburger -->
                    <ImageButton
                        android:id="@+id/btnOpenDrawer"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/desc_open_drawer"
                        android:src="@drawable/ic_drawer_menu"
                        app:tint="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Industrial Acoustic Sentinel"
                            android:textColor="@color/accent"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Ikona statusu / radaru -->
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_mic_radar"
                        app:tint="@color/accent" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Główny przewijany widok diagnostyczny -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nagłówek diagnostyczny -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_diagnostic"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subtitle_diagnostic"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Karta panelu sterowania diagnozą -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Nazwa badanego dysku -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_hdd_name"
                            android:textColorHint="@color/text_secondary"
                            app:boxBackgroundColor="@color/background_secondary"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="@color/accent"
                            app:hintTextColor="@color/accent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHddName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:text="HDD WDC WD10EZEX"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Ukryty kontener wyboru modelu (Aplikacja domyślnie korzysta z modelu produkcyjnego) -->
                        <LinearLayout
                            android:id="@+id/layoutModelSelectionHidden"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvModelSelectionLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_model_selection" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/toggleGroupModel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:checkedButton="@id/btnModelLegacy"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnModelLegacy"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/model_option_legacy" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnModelAlternative"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/model_option_alternative" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </LinearLayout>

                        <!-- Czysty tor audio RAW (Profesjonalny przełącznik) -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRawAudio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp"
                            android:checked="true"
                            android:minHeight="48dp"
                            android:paddingVertical="4dp"
                            android:text="@string/label_raw_audio_mode"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            app:thumbTint="@color/accent"
                            app:trackTint="@color/background_secondary"
                            app:useMaterialThemeColors="true" />

                        <!-- Sekcja Centralnego Przycisku Radaru (Hero Acoustic Listening) -->
                        <FrameLayout
                            android:id="@+id/layoutHeroRadar"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="6dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <View
                                android:id="@+id/viewPulseRing"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_radar_pulse_ring"
                                android:visibility="invisible" />

                            <ImageButton
                                android:id="@+id/btnHeroRadar"
                                android:layout_width="112dp"
                                android:layout_height="112dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_radar_button"
                                android:contentDescription="Stuknij, aby zbadać HDD"
                                android:elevation="8dp"
                                android:src="@drawable/ic_mic_radar"
                                app:tint="@color/text_primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvHeroHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:text="Stuknij, aby zbadać stan HDD"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Panel wskaźników badania i poziomu audio na żywo -->
                        <LinearLayout
                            android:id="@+id/layoutProgressSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_listening_panel"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <!-- Wskaźnik Czasu Badania i Okien -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvProgressTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Czas: 0.0 s / 9.0 s"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvProgressWindow"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:gravity="end"
                                    android:singleLine="true"
                                    android:text="Okno 1/5 (Wymagane min. 3.0s)"
                                    android:textColor="@color/accent"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Pasek postępu czasu nagrania -->
                            <ProgressBar
                                android:id="@+id/progressBarAudio"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="12dp"
                                android:max="100"
                                android:progress="0"
                                android:progressDrawable="@drawable/bg_progress_bar_rounded" />

                            <!-- Wskaźnik Poziomu Mikrofonu na Żywo (VU Meter) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sygnał mikrofonu:"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMicLevelLabel"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:gravity="end"
                                    android:singleLine="true"
                                    android:text="Nasłuchiwanie..."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    tools:text="Optymalny (RMS: 0.024)" />
                            </LinearLayout>

                            <!-- Pasek poziomu dźwięku mikrofonu -->
                            <ProgressBar
                                android:id="@+id/progressBarMicLevel"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="0"
                                android:progressDrawable="@drawable/bg_progress_mic_rounded" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRecordingStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="2dp"
                            android:gravity="center"
                            android:text="@string/status_idle"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Karta wyniku badania (ukryta domyślnie) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivResultIcon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_check_circle" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvResultHddName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    tools:text="Seagate Barracuda 2TB" />

                                <TextView
                                    android:id="@+id/tvResultClass"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="@color/text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="NORMAL" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvResultBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_normal"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="SPRAWNY"
                                android:textColor="@color/status_normal_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvResultConfidence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            tools:text="99.8% pewności (czas: 14 ms)" />

                        <TextView
                            android:id="@+id/tvResultRecommendation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_listening_panel"
                            android:padding="10dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="Dysk sprawny. Parametry akustyczne łożyska i głowic w normie." />

                        <!-- Rozkład prawdopodobieństw klas -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Rozkład prawdopodobieństw (Softmax):"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Normal -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="Normal"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <ProgressBar
                                android:id="@+id/progressNormal"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressBackgroundTint="@color/progress_track"
                                android:progressTint="@color/color_normal" />

                            <TextView
                                android:id="@+id/tvProbNormal"
                                android:layout_width="45dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                tools:text="95%" />
                        </LinearLayout>

                        <!-- Clicking -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="Clicking"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <ProgressBar
                                android:id="@+id/progressClicking"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressBackgroundTint="@color/progress_track"
                                android:progressTint="@color/color_clicking" />

                            <TextView
                                android:id="@+id/tvProbClicking"
                                android:layout_width="45dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                tools:text="3%" />
                        </LinearLayout>

                        <!-- Beeping -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="Beeping"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <ProgressBar
                                android:id="@+id/progressBeeping"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressBackgroundTint="@color/progress_track"
                                android:progressTint="@color/color_beeping" />

                            <TextView
                                android:id="@+id/tvProbBeeping"
                                android:layout_width="45dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                tools:text="1%" />
                        </LinearLayout>

                        <!-- Scratching -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="Scratching"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <ProgressBar
                                android:id="@+id/progressScratching"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressBackgroundTint="@color/progress_track"
                                android:progressTint="@color/color_scratching" />

                            <TextView
                                android:id="@+id/tvProbScratching"
                                android:layout_width="45dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                tools:text="1%" />
                        </LinearLayout>

                        <!-- Podgląd spektrogramu Mel -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Wygenerowany Spektrogram Mel (DSP):"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivSpectrogramPreview"
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/background_secondary"
                            android:contentDescription="Podgląd spektrogramu"
                            android:scaleType="fitXY" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSpectrogramPath"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="/data/user/0/.../spectrograms/spec_1.png" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExportResultSpectrogram"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:paddingHorizontal="6dp"
                                android:text="Zapisz w Galerii"
                                android:textColor="@color/accent"
                                android:textSize="11sp"
                                app:icon="@android:drawable/ic_menu_save"
                                app:iconSize="14dp"
                                app:iconTint="@color/accent" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sekcja historii badań -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_history"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearHistory"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_clear_history"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHistoryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/empty_history"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_diagnostic_history" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Szuflada nawigacyjna (NavigationView) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/background_secondary"
        android:fitsSystemWindows="true"
        app:elevation="16dp"
        app:headerLayout="@layout/layout_drawer_header"
        app:itemBackground="@drawable/bg_drawer_item"
        app:itemIconTint="@color/accent"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
