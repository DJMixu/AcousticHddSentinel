<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Uchwyt przeciągania -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/card_stroke" />

    <!-- Nagłówek -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/specs_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Standardy ADR-001 DSP &amp; ADR-002 Mobile Java 17"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSpecsClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Zamknij specyfikację"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="540dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SEKCJA 1: Parametry Przetwarzania Sygnałów DSP -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Parametry Sygnału i Przetwarzania DSP"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Częstotliwość próbkowania: 22 050 Hz (Target SR)\n• Transformata Fouriera (STFT): N_FFT = 1024, Hop Length = 256 (~11.6 ms krok)\n• Bank filtrów Mel: N_MELS = 128 pasm (50 Hz – 10 000 Hz, skala HTK)\n• Okno analityczne: 3.0 s (66 150 próbek float32)\n• Wymiary tensora wejściowego: 3 × 128 × 259 (Kanały: Log-Mel, Delta, Delta-Delta)\n• Zarządzanie pamięcią: Zero GC Churn (prealokowane bufory w czystej Javie 17)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SEKCJA 2: Architektura Sieci Neuronowej i Modelu AI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Architektura Sieci Neuronowej i ONNX"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Architektura: Głęboka sieć splotowa 2D CNN z wielomodalnymi podcentrami (SMPC Option A)\n• Klasy diagnostyczne: 4 (Normal, Clicking, Beeping, Scratching) + OOD Ambient\n• Silnik inferencji: ONNX Runtime Mobile v1.17\n• Kwantyzacja: INT8 Post-Training Quantization (1.17 MB – redukcja o 74.6% z 4.61 MB FP32)\n• Dokładność modelu: Test Accuracy 83.8%, Macro F1 84.6% (100% czułość dla dysków sprawnych)\n• Wzorzec Strategii: Przełączanie w locie (Model Klasyczny vs Model Alternatywny)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SEKCJA 3: Fizyczni Strażnicy DSP i Odporność Adwersarialna -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fizyczni Strażnicy DSP i Odporność Adwersarialna"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Detekcja obrotów RPM: Grzebień harmoniczny dla 5400 RPM (90 Hz), 7200 RPM (120 Hz), 10000 RPM (166.7 Hz), 15000 RPM (250 Hz)\n• Interpolacja paraboliczna pików: Precyzja częstotliwości podstawowej f0 ±0.3 Hz\n• Bramka ciszy / braku sygnału: Odrzucanie ramek o RMS &lt; 0.002\n• Filtr szumów wentylatorów PC: Analiza nachylenia widma (Spectral Slope &lt;= -1.80)\n• Odrzucanie przydźwięku sieciowego: Filtr harmonicznych 50/60 Hz oraz 100/120 Hz\n• Odporność na mowę ludzką: Weryfikacja stacjonarności pitch i brak wibrato"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
